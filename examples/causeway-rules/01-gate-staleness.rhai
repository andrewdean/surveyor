fn check(g) {
    let out = [];
    for p in PATHS {
        // Not in the graph: the walker does not enter dot-directories.
        if p.starts_with(".") { continue; }
        if g.node("file:" + p) == () && g.nodes_under("File", p + "/").len() == 0 {
            out.push(#{ message: "GATE IS STALE: referenced path no longer exists", subject: p });
        }
    }
    out
}
